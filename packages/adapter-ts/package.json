{
  "name": "@sdd-dev-kit/adapter-ts",
  "version": "0.1.0",
  "description": "SDD TypeScript adapter — Cucumber + Playwright scaffold, materialize, runners",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test src/**/*.test.ts",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@sdd-dev-kit/core": "0.1.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "@cucumber/cucumber": "^11.0.0",
    "@playwright/test": "^1.50.0"
  }
}
