{
  "name": "@sdd-dev-kit/cli",
  "version": "0.1.0",
  "description": "SDD Protocol Kit CLI — sdd init | run | verify | demo | status | from-ticket",
  "type": "module",
  "bin": {
    "sdd": "./dist/bin.js"
  },
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node ../../scripts/run-tsx-tests.mjs src",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@sdd-dev-kit/adapter-claude": "0.1.0",
    "@sdd-dev-kit/adapter-cursor": "0.1.0",
    "@sdd-dev-kit/adapter-node-graphql": "0.1.0",
    "@sdd-dev-kit/adapter-python": "0.1.0",
    "@sdd-dev-kit/adapter-react-vite": "0.1.0",
    "@sdd-dev-kit/adapter-shared": "0.1.0",
    "@sdd-dev-kit/adapter-terraform": "0.1.0",
    "@sdd-dev-kit/adapter-ts": "0.1.0",
    "@sdd-dev-kit/adapter-vscode-copilot": "0.1.0",
    "@sdd-dev-kit/core": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogeriobatista/sdd-dev-kit.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "license": "MIT"
}
