{
  "name": "coupon-checkout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SDD Dev Kit example — coupon checkout (edit specs only, run /sdd run)",
  "scripts": {
    "setup": "npm install && npx playwright install chromium",
    "build": "tsc -p tsconfig.json",
    "start:ui": "node --import tsx src/server.ts",
    "sdd:verify:cucumber": "node scripts/run-cucumber.mjs",
    "sdd:verify:playwright": "playwright test",
    "sdd:verify:all": "npm run sdd:verify:cucumber && npm run sdd:verify:playwright",
    "sdd:demo": "node scripts/build-demo.mjs",
    "smoke": "npm run sdd:verify:cucumber && playwright test --config=playwright.smoke.config.ts"
  },
  "dependencies": {
    "@sdd-dev-kit/adapter-ts": "0.1.0",
    "@sdd-dev-kit/core": "0.1.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
